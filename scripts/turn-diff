#!/usr/bin/env python3
"""turn-diff — 打印上一个 pi 轮次里 AI 改了什么（本轮增量）。

数据来自 turn-diff 扩展：它在每轮开始时记 git 基线，轮次结束时把「本轮增量」
（统计 + unified diff）落盘成一份 JSON。这个脚本只读那份状态，不跑 pi、不触发
任何会话，所以在任何终端里随时可以敲。

用法（会话里 /turn-diff 用同一套词）：
  turn-diff                   打印当前仓库上一轮的改动（摘要）
  turn-diff list              只列出这一轮改了哪些文件（带编号）
  turn-diff file              打印这一轮所有文件的正文
  turn-diff file 2            只看第 2 个文件（编号来自 list / 摘要）
  turn-diff file 'src/**'     只看路径匹配的文件（子串或通配）
  turn-diff view 2            在 cmux 的 diff 面板打开第 2 个文件（行级红绿，可开词级高亮）
  turn-diff render 2          把第 2 个文件的「改后」片段交给 cmux 的 markdown 面板（公式排版）
  turn-diff 2                 看再往前一轮
  turn-diff 2 file 3          第 2 轮里的第 3 个文件
  turn-diff --all             每个有轮次报告的仓库各一行摘要
  turn-diff --repo <路径>      指定仓库（默认当前目录）
  turn-diff --json            输出原始 JSON
  turn-diff --color <模式>     颜色：auto（默认，仅 TTY）/ always / never

颜色：新增行绿底、删除行红底，行内真正改动的那几个片段用更亮的底色标出来。
兼容：--patch / -p 等同 file，--file <x> 等同 file <x>，--list 等同 list，--turn <n> 等同 <n>。
退出码：0 = 有内容；1 = 没有可汇报的改动；2 = 用法 / 环境问题。
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import tempfile
import time
from datetime import datetime
from pathlib import Path

STATE_DIR = Path(os.environ.get("TURN_DIFF_STATE_DIR") or (Path.home() / ".pi" / "agent" / "state" / "turn-diff"))
STATE_FILE = STATE_DIR / "last-turn.json"

KIND_MARK = {"added": "A", "deleted": "D", "renamed": "R", "modified": "M"}

# 256 色：暗绿 / 亮绿 / 暗红 / 亮红 + 白字
RESET = "\x1b[0m"
FG = "\x1b[38;5;231m"
ADD_BG = "\x1b[48;5;22m"
ADD_STRONG = "\x1b[48;5;28m"
DEL_BG = "\x1b[48;5;52m"
DEL_STRONG = "\x1b[48;5;88m"
ADD_FG = "\x1b[38;5;120m"
DEL_FG = "\x1b[38;5;210m"

MAX_INLINE_TOKENS = 400


def die(message: str, code: int = 2) -> "NoReturn":  # type: ignore[name-defined]
    print(message, file=sys.stderr)
    raise SystemExit(code)


def use_color(choice: str) -> bool:
    if choice == "always":
        return True
    if choice == "never":
        return False
    if os.environ.get("NO_COLOR"):
        return False
    return sys.stdout.isatty()


def to_seconds(value) -> float | None:
    """扩展用的是 JS 的 Date.now()（毫秒），这里统一折成秒。"""
    try:
        stamp = float(value)
    except (TypeError, ValueError):
        return None
    if stamp <= 0:
        return None
    return stamp / 1000 if stamp > 1e11 else stamp


def git(cwd: str, *args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)


def repo_root(path: str) -> str | None:
    if not os.path.isdir(path):
        return None
    result = git(path, "rev-parse", "--show-toplevel")
    if result.returncode != 0:
        return None
    root = result.stdout.strip()
    return os.path.realpath(root) if root else None


def load_json(path: Path) -> dict:
    try:
        with path.open(encoding="utf-8") as handle:
            return json.load(handle)
    except Exception:
        return {}


def turns_of(entry) -> list[dict]:
    """把落盘条目归一成一串轮次（新的在前）；兼容老的「单条」结构。"""
    if not isinstance(entry, dict):
        return []
    turns = entry.get("turns")
    if isinstance(turns, list):
        return [item for item in turns if isinstance(item, dict)]
    if entry.get("files") is not None:
        return [entry]
    return []


# ===== 按文件切分 =====


def split_patch_by_file(patch: str) -> list[tuple[str, str]]:
    """把整段 patch 按文件切开（返回 [(path, text)]），兼容没有 diff --git 头的老记录。"""
    lines = patch.split("\n")
    chunks: list[tuple[str, list[str]]] = []
    current: list[str] = []
    current_path = ""

    def flush() -> None:
        nonlocal current, current_path
        if current:
            chunks.append((current_path, current))
        current, current_path = [], ""

    index = 0
    while index < len(lines):
        line = lines[index]
        if line.startswith("diff --git "):
            flush()
            import re

            match = re.match(r"^diff --git a/(.+?) b/(.+)$", line)
            current_path = match.group(2) if match else ""
            current.append(line)
        elif line == "--- /dev/null":
            import re

            match = re.match(r"^\+\+\+ b/(.+)$", lines[index + 1] if index + 1 < len(lines) else "")
            if match:
                # 老记录的未跟踪文件段没有 diff --git 头：换文件时从这里切开
                if current_path and current_path != match.group(1):
                    flush()
                current_path = match.group(1)
            current.append(line)
        elif not (line == "" and index == len(lines) - 1):
            current.append(line)
        index += 1
    flush()
    return [(path, "\n".join(body)) for path, body in chunks if "\n".join(body).strip()]


def match_path(candidate: str, pattern: str) -> bool:
    """先按子串匹配，再按 * / ? 通配（都忽略大小写）。"""
    import fnmatch

    lowered = candidate.lower()
    pattern = pattern.lower()
    return pattern in lowered or fnmatch.fnmatch(lowered, pattern)


# ===== 交给 cmux 渲染（可选） =====

CMUX_META = (
    "diff --git ",
    "index ",
    "--- ",
    "+++ ",
    "@@",
    "new file mode",
    "deleted file mode",
    "old mode",
    "new mode",
    "similarity index",
    "rename from",
    "rename to",
)


def find_cmux_cli():
    """找 /Applications 或 ~/Applications 下 cmux*.app 里的命令行；找不到返回 None。"""
    homes = [Path("/Applications"), Path.home() / "Applications"]
    found = []
    for home in homes:
        try:
            for entry in home.iterdir():
                if not entry.name.lower().startswith("cmux") or not entry.name.endswith(".app"):
                    continue
                cli = entry / "Contents/Resources/bin/cmux"
                if cli.exists():
                    found.append(cli)
        except OSError:
            continue
    if not found:
        return None
    found.sort(key=lambda item: 0 if "STAGING" in str(item) else 1)
    return found[0]


def escape_html(text: str) -> str:
    # ~ 也要转义：否则原文里的 ~~删除线~~ 会被 markdown 当成真删除线，和本次改动混淆
    return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("~", "&#126;")


def has_own_marks(text: str) -> bool:
    return bool(re.search(r"~~|<\/?u>|<\/?ins>|<\/?del>|<\/?s>", text))


def build_render_document(chunk_text: str) -> str:
    """只呈现红的删除行 / 绿的新增行：整行套 hljs-deletion/addition，词级改动加 del/u。"""
    lines = chunk_text.split("\n")
    out: list[str] = []
    ambiguous = False

    def wrap(kind: str, segments: list[tuple[str, bool]], mark: str) -> None:
        body = "".join(
            f"<{mark}>{escape_html(text)}</{mark}>" if strong else escape_html(text) for text, strong in segments
        )
        out.append(f'<span class="hljs-{kind}">{body}</span>')
        out.append("")

    index = 0
    while index < len(lines):
        line = lines[index]
        if not ((line.startswith("-") and not line.startswith("--- ")) or (line.startswith("+") and not line.startswith("+++ "))):
            index += 1
            continue
        removed = []
        while index < len(lines) and lines[index].startswith("-") and not lines[index].startswith("--- "):
            removed.append(lines[index][1:])
            index += 1
        added = []
        while index < len(lines) and lines[index].startswith("+") and not lines[index].startswith("+++ "):
            added.append(lines[index][1:])
            index += 1
        pairs = min(len(removed), len(added))
        for pair in range(pairs):
            if has_own_marks(removed[pair]) or has_own_marks(added[pair]):
                ambiguous = True
            del_segments, add_segments = inline_tokens(removed[pair], added[pair])
            wrap("deletion", del_segments, "del")
            wrap("addition", add_segments, "u")
        for text in removed[pairs:]:
            if has_own_marks(text):
                ambiguous = True
            wrap("deletion", [(text, False)], "del")
        for text in added[pairs:]:
            if has_own_marks(text):
                ambiguous = True
            wrap("addition", [(text, False)], "u")

    if not out:
        return ""
    header = [
        '**改动**：<span class="hljs-deletion">红底=删除行</span>（被删的片段加<del>中划线</del>）、'
        '<span class="hljs-addition">绿底=新增行</span>（新增的片段加<u>下划线</u>）。未变动的行不在这里显示。',
    ]
    if ambiguous:
        header += [
            "",
            "> ⚠️ 这一轮的改动内容里本来就有删除线 / 下划线标记（`~~`、`<u>`、`<ins>` 之类），"
            "下面的颜色与划线是本次改动的标记，可能和原文样式混在一起——原文里的标记这里一律按字面显示。",
        ]
    body = "\n".join(out).rstrip("\n")
    return "\n".join(header) + "\n\n" + body + "\n"


def open_patch_in_cmux(chunk: tuple[str, str]) -> int:
    """把该文件的 patch 交给 cmux 的 diff 面板（它自带行级红绿与可选的词级高亮）。"""
    cli = find_cmux_cli()
    if not cli:
        die("没找到 cmux（/Applications 下没有 cmux*.app），无法打开 diff 面板。", 1)
    target = Path(tempfile.gettempdir()) / f"turn-diff-patch-{int(time.time() * 1000)}.patch"
    body = chunk[1] if chunk[1].endswith("\n") else chunk[1] + "\n"
    target.write_text(body, encoding="utf-8")
    result = subprocess.run(
        [str(cli), "diff", str(target), "--title", chunk[0], "--no-focus"],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip().splitlines()
        die(f"cmux diff 打开失败：{detail[0] if detail else '未知错误'}", 1)
    surface = ""
    for token in result.stdout.split():
        if token.startswith("surface="):
            surface = token
    print(f"已在 cmux 的 diff 面板打开：{chunk[0]}（{surface or '面板已打开'}，未抢焦点）")
    return 0


def cmux_call_env() -> dict:
    """调 cmux 时去掉调用者上下文（失效的 surface 会让 CLI 报 Source surface not found）。"""
    return {k: v for k, v in os.environ.items() if k not in ("CMUX_WORKSPACE_ID", "CMUX_SURFACE_ID", "CMUX_PANEL_ID")}


def open_rendered(chunk: tuple[str, str]) -> int:
    cli = find_cmux_cli()
    if not cli:
        die("没找到 cmux（/Applications 下没有 cmux*.app），无法渲染。", 1)
    fragment = build_render_document(chunk[1])
    if not fragment.strip():
        die("这个文件的改动没有可显示的内容。", 1)
    target = Path(tempfile.gettempdir()) / f"turn-diff-view-{int(time.time() * 1000)}.md"
    target.write_text(fragment + "\n", encoding="utf-8")
    # 用 cmux open（而不是 cmux markdown open）：它把 .md 作为标签页塞进当前 pane，
    # markdown open 则必定新开 split（用户明确不要 split）
    env = cmux_call_env()
    result = subprocess.run(
        [str(cli), "open", str(target), "--no-focus"],
        capture_output=True,
        text=True,
        env=env,
    )
    if result.returncode != 0:
        # 退回老路径（会新开 split，但至少能看）
        result = subprocess.run(
            [str(cli), "markdown", "open", str(target), "--focus", "false"],
            capture_output=True,
            text=True,
            env=env,
        )
    if result.returncode != 0:
        raw = (result.stderr or result.stdout).strip()
        detail = raw.splitlines()[0] if raw else "未知错误"
        die(f"cmux 渲染失败：{detail}（已试过 cmux open 与 cmux markdown open）", 1)
    surface = ""
    for token in result.stdout.split():
        if token.startswith("surface="):
            surface = token
    print(f"已交给 cmux 渲染改动片段：{chunk[0]}（{surface or '面板已打开'}，未抢焦点）")
    print(f"临时文件：{target}")
    return 0


# ===== 彩色 patch =====


def tokenize(line: str) -> list[str]:
    """按「空白 / 单词 / 单个符号」切词，保留空白以便拼回原行。"""
    import re

    return re.findall(r"\s+|\w+|[^\s\w]", line)


def inline_tokens(removed: str, added: str) -> tuple[list[tuple[str, bool]], list[tuple[str, bool]]]:
    """两行之间的 token 级 LCS，返回 (删除侧片段, 新增侧片段)，bool 表示是否「真正改动」。"""
    left, right = tokenize(removed), tokenize(added)
    if not left or not right or len(left) > MAX_INLINE_TOKENS or len(right) > MAX_INLINE_TOKENS:
        return [(removed, True)], [(added, True)]

    table = [[0] * (len(right) + 1) for _ in range(len(left) + 1)]
    for i in range(len(left) - 1, -1, -1):
        for j in range(len(right) - 1, -1, -1):
            table[i][j] = (
                table[i + 1][j + 1] + 1 if left[i] == right[j] else max(table[i + 1][j], table[i][j + 1])
            )

    def push(items: list[tuple[str, bool]], text: str, strong: bool) -> None:
        if items and items[-1][1] == strong:
            items[-1] = (items[-1][0] + text, strong)
        else:
            items.append((text, strong))

    dels: list[tuple[str, bool]] = []
    adds: list[tuple[str, bool]] = []
    i = j = 0
    while i < len(left) and j < len(right):
        if left[i] == right[j]:
            push(dels, left[i], False)
            push(adds, right[j], False)
            i += 1
            j += 1
        elif table[i + 1][j] >= table[i][j + 1]:
            push(dels, left[i], True)
            i += 1
        else:
            push(adds, right[j], True)
            j += 1
    while i < len(left):
        push(dels, left[i], True)
        i += 1
    while j < len(right):
        push(adds, right[j], True)
        j += 1
    return dels, adds


def paint(segments: list[tuple[str, bool]], base_bg: str, strong_bg: str, colored: bool) -> str:
    if not colored:
        return "".join(text for text, _ in segments)
    return "".join(f"{FG}{strong_bg if strong else base_bg}{text}{RESET}" for text, strong in segments)


def paint_line(text: str, bg: str, colored: bool) -> str:
    return f"{FG}{bg}{text}{RESET}" if colored else text


def classify(line: str) -> str:
    import re

    if (
        line.startswith("diff ")
        or line.startswith("index ")
        or line.startswith("@@")
        or re.match(r"^--- (a/|/dev/null)", line)
        or re.match(r"^\+\+\+ (b/|/dev/null)", line)
    ):
        return "meta"
    if line.startswith("+"):
        return "add"
    if line.startswith("-"):
        return "del"
    return "context"


def render_patch(patch: str, colored: bool) -> list[str]:
    """把 patch 渲染成带底色的行：整行绿/红底，行内改动片段用更亮的底色。"""
    raw = patch.split("\n")
    if raw and raw[-1] == "":
        raw.pop()
    out: list[str] = []
    index = 0
    while index < len(raw):
        line = raw[index]
        kind = classify(line)
        if kind == "del":
            dels: list[str] = []
            while index < len(raw) and classify(raw[index]) == "del":
                dels.append(raw[index][1:])
                index += 1
            adds: list[str] = []
            lookahead = index
            while lookahead < len(raw) and classify(raw[lookahead]) == "add":
                adds.append(raw[lookahead][1:])
                lookahead += 1
            pairs = min(len(dels), len(adds))
            for k, text in enumerate(dels):
                if k < pairs:
                    del_segments, _ = inline_tokens(text, adds[k])
                    out.append(f"- {paint(del_segments, DEL_BG, DEL_STRONG, colored)}")
                else:
                    out.append(f"- {paint_line(text, DEL_BG, colored)}")
            for k, text in enumerate(adds):
                if k < pairs:
                    _, add_segments = inline_tokens(dels[k], text)
                    out.append(f"+ {paint(add_segments, ADD_BG, ADD_STRONG, colored)}")
                else:
                    out.append(f"+ {paint_line(text, ADD_BG, colored)}")
            index = lookahead
            continue
        if kind == "add":
            out.append(f"+ {paint_line(line[1:], ADD_BG, colored)}")
            index += 1
            continue
        if kind == "context":
            out.append(f"  {line[1:] if line.startswith(' ') else line}")
            index += 1
            continue
        out.append(line)
        index += 1
    return out


def stat_text(kind: str, added: int, deleted: int, colored: bool) -> str:
    if kind == "deleted":
        return f"{DEL_FG}-{deleted}{RESET}" if colored else f"-{deleted}"
    if kind == "added":
        return f"{ADD_FG}+{added}{RESET}" if colored else f"+{added}"
    if not colored:
        return f"+{added} -{deleted}"
    return f"{ADD_FG}+{added}{RESET} {DEL_FG}-{deleted}{RESET}"


def fmt_report(report: dict, generated_at, colored: bool) -> str:
    files = report.get("files") or []
    name = report.get("repoName") or "?"
    title = f"本轮改动 · {len(files)} 个文件 · +{report.get('added', 0)} -{report.get('deleted', 0)} · {name}"
    lines = [title]
    width = max((len(str(item.get("path", ""))) for item in files), default=0)
    for item in files:
        mark = KIND_MARK.get(str(item.get("kind")), "M")
        stat = "二进制" if item.get("binary") else stat_text(str(item.get("kind")), item.get("added", 0), item.get("deleted", 0), colored)
        lines.append(f"  {mark} {str(item.get('path', '')).ljust(width)}  {stat}")
    seconds = to_seconds(generated_at)
    if seconds:
        stamp = datetime.fromtimestamp(seconds).strftime("%Y-%m-%d %H:%M:%S")
        lines.append(f"生成于 {stamp} · {report.get('repoRoot', '')}")
    return "\n".join(lines)


def summarize(report: dict) -> str:
    files = report.get("files") or []
    return (
        f"{report.get('repoName', '?'):<28} {len(files):>3} 个文件  "
        f"+{report.get('added', 0):<5} -{report.get('deleted', 0):<5} {report.get('repoRoot', '')}"
    )


def main(argv: list[str]) -> int:
    args = list(argv[1:])
    as_json = False
    show_all = False
    color_choice = "auto"
    repo_arg = None
    verbs: list[str] = []
    patterns: list[str] = []

    index = 0
    while index < len(args):
        arg = args[index]
        if arg in ("--repo", "--color", "--file", "--turn"):
            if index + 1 >= len(args):
                die(f"{arg} 需要取值")
            value = args[index + 1]
            if arg == "--repo":
                repo_arg = value
            elif arg == "--color":
                color_choice = value
            elif arg == "--file":
                verbs.append("file")
                patterns.append(value)
            else:  # --turn
                verbs.append(value)
            index += 2
            continue
        if arg.startswith("--color="):
            color_choice = arg.split("=", 1)[1]
        elif arg == "--json":
            as_json = True
        elif arg == "--all":
            show_all = True
        elif arg in ("--patch", "-p"):
            verbs.append("file")
        elif arg in ("--list", "list"):
            verbs.append("list")
        elif arg == "file":
            verbs.append("file")
        elif arg in ("view", "render"):
            verbs.append("file")
            verbs.append(arg)
        elif arg == "head":
            die("这个项目只看「本轮改了什么」。要看全部未提交改动，请直接用 git diff。")
        elif arg.isdigit():
            # 出现在 file 之后的数字是「第几个文件」，之前的是「第几轮」
            if "file" in verbs and not patterns:
                patterns.append(arg)
            else:
                verbs.append(arg)
        else:
            patterns.append(arg)
        index += 1

    if color_choice not in ("auto", "always", "never"):
        die("--color 只接受 auto / always / never")
    colored = use_color(color_choice)

    state = load_json(STATE_FILE).get("repos") or {}

    if show_all:
        rows = [turns[0] for turns in (turns_of(entry) for entry in state.values()) if turns]
        if not rows:
            die("还没有任何仓库的轮次报告。", 1)
        for report in sorted(rows, key=lambda item: to_seconds(item.get("generatedAt")) or 0, reverse=True):
            print(summarize(report))
        return 0

    root = repo_root(repo_arg or os.getcwd())
    if not root:
        die("这里不是 git 仓库（或用 --repo 指定一个仓库路径）。")

    turns = turns_of(state.get(root))
    if not turns:
        die("这个仓库还没有轮次报告：跑一轮带文件改动的 pi 任务后再来。", 1)

    turn_numbers = [int(verb) for verb in verbs if verb.isdigit()]
    turn_index = max(0, turn_numbers[-1] - 1) if turn_numbers else 0
    if turn_index >= len(turns):
        die(f"只存了最近 {len(turns)} 轮，没有第 {turn_index + 1} 轮。", 1)
    report = turns[turn_index]

    want_list = "list" in verbs
    file_filter = patterns[0] if patterns else None
    want_body = "file" in verbs or file_filter is not None

    if as_json and not want_list and not want_body:
        print(json.dumps(report, ensure_ascii=False, indent=2))
        return 0

    files = report.get("files") or []
    if want_list:
        for number, item in enumerate(files, start=1):
            mark = KIND_MARK.get(str(item.get("kind")), "M")
            stat = "二进制" if item.get("binary") else stat_text(str(item.get("kind")), item.get("added", 0), item.get("deleted", 0), colored)
            print(f"  {number}. {mark} {item.get('path')}  {stat}")
        return 0

    print(fmt_report(report, report.get("generatedAt"), colored))
    if not want_body:
        return 0

    patch = report.get("patch")
    if not patch:
        print()
        print("（这一轮没有存正文：这份报告是旧版本落盘的，或本轮没有文本改动。当前工作区可以直接 `git diff`。）")
        return 0

    if "view" in verbs or "render" in verbs:
        chunks = split_patch_by_file(patch)
        if file_filter:
            if file_filter.isdigit():
                position = int(file_filter) - 1
                if not 0 <= position < len(files):
                    die(f"没有第 {file_filter} 个文件（先用 turn-diff list 看编号）。", 1)
                wanted_path = str(files[position].get("path"))
                chunks = [chunk for chunk in chunks if chunk[0] == wanted_path]
            else:
                chunks = [chunk for chunk in chunks if match_path(chunk[0], file_filter)]
        verb = "view" if "view" in verbs else "render"
        if len(chunks) != 1:
            die(f"{verb} 一次只看一个文件：用 turn-diff {verb} <编号> 指定（先 turn-diff list 看编号）。", 1)
        return open_patch_in_cmux(chunks[0]) if verb == "view" else open_rendered(chunks[0])

    if file_filter:
        chunks = split_patch_by_file(patch)
        if file_filter.isdigit():
            position = int(file_filter) - 1
            if not 0 <= position < len(files):
                die(f"没有第 {file_filter} 个文件（先用 turn-diff list 看编号）。", 1)
            wanted_path = str(files[position].get("path"))
            chunks = [chunk for chunk in chunks if chunk[0] == wanted_path]
        else:
            chunks = [chunk for chunk in chunks if match_path(chunk[0], file_filter)]
        if not chunks:
            die(f"没有匹配 {file_filter!r} 的文件（先用 turn-diff list 看编号）。", 1)
        patch = "\n".join(text for _, text in chunks)

    print()
    print("\n".join(render_patch(patch, colored)))
    if report.get("patchTruncated"):
        print()
        print("（正文过长，已截断。）")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
